{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Compatibility preset for the wider PHPStan tool ecosystem.",
  "extends": ["group:phpstan"],
  "packageRules": [
    {
      "description": "Group PHPStan extensions and closely related analysis tools.",
      "matchDatasources": ["packagist"],
      "matchPackageNames": [
        "phpstan/*",
        "ergebnis/phpstan-rules",
        "shipmonk/dead-code-detector",
        "shipmonk/phpstan-rules",
        "swissspidy/phpstan-no-private",
        "tomasvotruba/type-coverage",
        "yamadashy/phpstan-friendly-formatter"
      ],
      "groupName": "PHPStan",
      "groupSlug": "phpstan"
    }
  ]
}
